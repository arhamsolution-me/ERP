# ─────────────────────────────────────────────────────────────────────────────
# NexERP — API Service Environment Configuration
# apps/api/.env.example
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (PostgreSQL with RLS) ───────────────────────────────────────────
# e.g., postgresql://postgres:postgres@localhost:5432/nexerp_dev?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexerp_dev?schema=public

# ── Redis (Cache, Pub/Sub & Queue) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Clerk Authentication ─────────────────────────────────────────────────────
# Obtain keys from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_placeholder_key_here
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# ── Rate Limiting (Throttler) ────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── SMTP Email Dispatch ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=devnexes.support@gmail.com
SMTP_PASS=your_app_password_here
